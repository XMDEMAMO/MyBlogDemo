---
const PageTitle = "关于页"
const identity = {
    name: "马蒂亚斯",
    group: "蜘蛛巢",
    occupation: "（前）中指长兄",
    hobbies:["拼模型","打游戏","复仇","莱瓦汀"]
}
const skills = ["仇怨重踏","即刻处刑[莱瓦汀]","踏碎","犯规","穿腹[莱瓦汀]"]
const skillColor = "blueviolet"
const skillFontSize = "20px"
const skillFontWeight = "bold"
const skillFontStyle = "oblique"
---

<html lang="zh-cn">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
         <style define:vars={{skillColor,skillFontSize,skillFontStyle,skillFontWeight}}>
      h1 {
        color: blueviolet;
        font-size: 4rem;
      }

      .skill{
        color:var(--skillColor);
        font-size:var(--skillFontSize);
        font-style:var(--skillFontStyle);
        font-weight:var(--skillFontWeight);
      }
    </style>
        <title>{PageTitle}</title>
	</head>
	<body>
        <a href="/">首页</a>

		<h1>{PageTitle}</h1>
		<h2>我的Astro网站</h2>

        <h3>关于我：</h3>
        <ul>
            <li><p>我的名字是{identity.name}</p></li>
            <li><p>我住在{identity.group}</p></li>
            <li><p>我是{identity.occupation}</p></li>
            { identity.hobbies.length>=4&& 
            <li>我的爱好是{identity.hobbies[0]}、{identity.hobbies[1]}、{identity.hobbies[2]}和{identity.hobbies[3]}</li>
            }
        </ul>

    <p>我的技能是：</p>
    <ul>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>

        <p>这个是跟着Astro教程做的示例网站，将随着教程不断更新</p>
	</body>
</html>